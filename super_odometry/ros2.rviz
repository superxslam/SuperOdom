Panels:
  - Class: rviz_common/Displays
    Help Height: 191
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Status1
        - /LaserOdomPath1/Topic1
        - /IMUOdometry1
        - /RegisteredScan1
        - /TF1
        - /TF1/Frames1
        - /GlobalMap1
      Splitter Ratio: 0.5
    Tree Height: 592
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Tool Properties
    Expanded:
      - /2D Goal Pose1
      - /Publish Point1
    Name: Tool Properties
    Splitter Ratio: 0.5886790156364441
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
  - Class: rviz_common/Time
    Experimental: false
    Name: Time
    SyncMode: 0
    SyncSource: RegisteredScan
