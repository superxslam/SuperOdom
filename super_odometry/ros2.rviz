        - /Gravity_RegisteredScan2
        - /TF1
        - /TF1/Frames1
        - /GlobalMap1/Autocompute Value Bounds1
        - /Image1
        - /Image1/Topic1
      Splitter Ratio: 0.5
    Tree Height: 357
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Tool Properties
    Expanded:
      - /2D Goal Pose1
      - /Publish Point1
    Name: Tool Properties
    Splitter Ratio: 0.5886790156364441
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
  - Class: rviz_common/Time
    Experimental: false
    Name: Time
    SyncMode: 0
    SyncSource: Gravity_RegisteredScan
